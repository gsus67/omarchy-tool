#!/bin/bash

# Put first on PATH by `omarchy-tool windows-disks launch` only. Adds the
# configured disks to the RDP session, then hands off to the real xfreerdp3.

shim_dir=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
PATH=$(tr ':' '\n' <<<"$PATH" | grep -vxF -- "$shim_dir" | paste -sd:)
export PATH

drives=()
while IFS= read -r arg; do
  [[ -n $arg ]] && drives+=("$arg")
done < <("$shim_dir/../omarchy-tool" windows-disks rdp-args 2>/dev/null)

exec xfreerdp3 "$@" "${drives[@]}"
