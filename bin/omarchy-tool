#!/bin/bash

# omarchy-tool: backend for the omarchy-tool Omarchy plugin.
#
# Every feature is a module in bin/modules/<name>.sh. A module defines
# functions named <name>_<action> (dashes become underscores), plus optional
# <name>_status (JSON for the panel) and <name>_apply (sync side effects with
# the saved config). The panel only talks to this command.
#
# Usage:
#   omarchy-tool status                 JSON state of every module
#   omarchy-tool apply                  Re-apply every module's config
#   omarchy-tool uninstall              Remove every trace outside the plugin
#   omarchy-tool self-update            Update from GitHub if a newer version exists
#   omarchy-tool modules                List module names
#   omarchy-tool <module> <action> ...  Run a module action

set -euo pipefail

TOOL_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
TOOL_VERSION=$(jq -r '.version // "0.0.0"' "$TOOL_DIR/manifest.json" 2>/dev/null || echo "0.0.0")
CONFIG_DIR="${OMARCHY_TOOL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-tool}"
CONFIG_FILE="$CONFIG_DIR/config.json"
STATE_DIR="${OMARCHY_TOOL_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-tool}"
MENU_FILE="${OMARCHY_TOOL_MENU_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc}"
export TOOL_DIR CONFIG_DIR CONFIG_FILE STATE_DIR

fail() {
  echo "omarchy-tool: $*" >&2
  exit 1
}

# --- config helpers ----------------------------------------------------------

config_read() {
  if [[ -s $CONFIG_FILE ]] && jq -e 'type == "object"' "$CONFIG_FILE" >/dev/null 2>&1; then
    cat "$CONFIG_FILE"
  else
    echo '{}'
  fi
}

# config_get <jq filter> [jq args...]
config_get() {
  local filter=$1
  shift
  config_read | jq "$@" "$filter"
}

# config_update <jq filter> [jq args...] -- writes atomically.
config_update() {
  local filter=$1 tmp
  shift
  mkdir -p -- "$CONFIG_DIR"
  tmp=$(mktemp "$CONFIG_DIR/.config.json.XXXXXX")
  if ! config_read | jq "$@" "$filter" >"$tmp"; then
    rm -f -- "$tmp"
    fail "could not update $CONFIG_FILE"
  fi
  mv -f -- "$tmp" "$CONFIG_FILE"
}

# --- modules -----------------------------------------------------------------

module_names() {
  local file
  for file in "$TOOL_DIR"/bin/modules/*.sh; do
    [[ -e $file ]] || continue
    basename -- "$file" .sh
  done
}

for module_file in "$TOOL_DIR"/bin/modules/*.sh; do
  [[ -e $module_file ]] || continue
  # shellcheck source=/dev/null
  source "$module_file"
done

module_fn() {
  local name="${1}_${2}"
  echo "${name//-/_}"
}

has_fn() {
  declare -F -- "$1" >/dev/null
}

cmd_status() {
  local name fn json='{}' module_json
  for name in $(module_names); do
    fn=$(module_fn "$name" status)
    has_fn "$fn" || continue
    module_json=$("$fn") || module_json='{"error":"status failed"}'
    json=$(jq --arg name "$name" --argjson value "$module_json" '.[$name] = $value' <<<"$json")
  done
  jq -n --arg version "$TOOL_VERSION" --arg uninstaller "$STATE_DIR/uninstall.sh" --argjson modules "$json" \
    '{version: $version, uninstaller: $uninstaller, modules: $modules}'
}

# Keep a copy of the uninstaller outside the plugin folder: once `omarchy
# plugin remove` deletes the folder, this copy is what cleans up.
install_uninstaller() {
  mkdir -p -- "$STATE_DIR"
  install -m 0755 -- "$TOOL_DIR/bin/uninstall.sh" "$STATE_DIR/uninstall.sh"
}

# One row in the Omarchy menu that toggles the panel. Only an existing user
# menu file is touched; uninstall.sh deletes the row by the same id.
menu_entry_apply() {
  [[ -f $MENU_FILE ]] || return 0
  grep -q '^  "omarchy-tool": {' "$MENU_FILE" && return 0
  local tmp
  tmp=$(mktemp "$MENU_FILE.XXXXXX")
  awk -v row='  "omarchy-tool": {"icon":"󰦬","label":"Omarchy Tool","action":"omarchy-shell omarchy-tool toggle"},' '
    { lines[NR] = $0 }
    END {
      last = 0
      for (i = NR; i > 0; i--) if (lines[i] ~ /^}[[:space:]]*$/) { last = i; break }
      for (i = 1; i <= NR; i++) { if (i == last) print row; print lines[i] }
    }
  ' "$MENU_FILE" >"$tmp" && mv -f -- "$tmp" "$MENU_FILE"
}

# Fast-forward the installed plugin when its git remote has new commits, via
# Omarchy's own updater. Only an install under Omarchy's plugin folder updates
# itself; a dev checkout never does. One run at a time across bar instances.
cmd_self_update() {
  local plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
  local lock="${XDG_RUNTIME_DIR:-/tmp}/omarchy-tool-update.lock"
  [[ $TOOL_DIR == "$plugins_dir/omarchy-tool" ]] || return 0
  [[ -d $TOOL_DIR/.git ]] || return 0

  exec 9>"$lock"
  flock -n 9 || return 0

  git -C "$TOOL_DIR" fetch -q origin 2>/dev/null || return 0
  local head upstream
  head=$(git -C "$TOOL_DIR" rev-parse HEAD) || return 0
  upstream=$(git -C "$TOOL_DIR" rev-parse '@{upstream}' 2>/dev/null) || return 0
  [[ $head != "$upstream" ]] || return 0
  git -C "$TOOL_DIR" merge-base --is-ancestor HEAD '@{upstream}' || return 0

  omarchy-plugin-update omarchy-tool --yes >/dev/null 2>&1 || return 1
  local version
  version=$(jq -r '.version // ""' "$TOOL_DIR/manifest.json" 2>/dev/null)
  omarchy-notification-send -g "󰦬" "Omarchy Tool actualizado" "Ya tienes la versión ${version:-nueva}." >/dev/null 2>&1 || true
}

cmd_apply() {
  local name fn status=0
  install_uninstaller
  menu_entry_apply
  for name in $(module_names); do
    fn=$(module_fn "$name" apply)
    has_fn "$fn" || continue
    "$fn" || status=1
  done
  return "$status"
}

main() {
  local command=${1:-}
  [[ $# -gt 0 ]] && shift

  case $command in
    status) cmd_status ;;
    apply) cmd_apply ;;
    uninstall) bash "$TOOL_DIR/bin/uninstall.sh" ;;
    self-update) cmd_self_update ;;
    modules) module_names ;;
    version | --version) echo "$TOOL_VERSION" ;;
    "" | help | -h | --help)
      sed -n '3,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      ;;
    *)
      local action=${1:-} fn
      module_names | grep -qxF -- "$command" || fail "unknown command or module: $command"
      [[ -n $action ]] || fail "missing action for module $command"
      shift
      fn=$(module_fn "$command" "$action")
      has_fn "$fn" || fail "unknown action for $command: $action"
      "$fn" "$@"
      ;;
  esac
}

main "$@"
