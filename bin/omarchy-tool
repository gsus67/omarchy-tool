#!/bin/bash

# omarchy-tool: backend for the omarchy-tool Omarchy plugin.
#
# Every feature is a module in bin/modules/<name>.sh. A module defines
# functions named <name>_<action> (dashes become underscores), plus optional
# <name>_status (JSON for the panel) and <name>_apply (sync side effects with
# the saved config). The panel only talks to this command.
#
# Usage:
#   omarchy-tool status                 JSON state of every module
#   omarchy-tool apply                  Re-apply every module's config
#   omarchy-tool uninstall              Remove every trace outside the plugin
#   omarchy-tool self-update            Update from GitHub if a newer version exists
#   omarchy-tool modules                List module names
#   omarchy-tool <module> <action> ...  Run a module action

set -euo pipefail

TOOL_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
source "$TOOL_DIR/bin/i18n.sh"
TOOL_VERSION=$(jq -r '.version // "0.0.0"' "$TOOL_DIR/manifest.json" 2>/dev/null || echo "0.0.0")
CONFIG_DIR="${OMARCHY_TOOL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-tool}"
CONFIG_FILE="$CONFIG_DIR/config.json"
STATE_DIR="${OMARCHY_TOOL_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-tool}"
COMPOSE_FILE="${OMARCHY_TOOL_COMPOSE:-/var/lib/omarchy/windows/docker-compose.yml}"
HYPR_DIR="${OMARCHY_TOOL_HYPR_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr}"
MENU_FILE="${OMARCHY_TOOL_MENU_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc}"
export TOOL_DIR CONFIG_DIR CONFIG_FILE STATE_DIR

fail() {
  printf 'omarchy-tool: %s\n' "$(tool_text "$*")" >&2
  exit 1
}

# --- config helpers ----------------------------------------------------------

config_read() {
  if [[ -s $CONFIG_FILE ]] && jq -e 'type == "object"' "$CONFIG_FILE" >/dev/null 2>&1; then
    cat "$CONFIG_FILE"
  else
    echo '{}'
  fi
}

# config_get <jq filter> [jq args...]
config_get() {
  local filter=$1
  shift
  config_read | jq "$@" "$filter"
}

# config_update <jq filter> [jq args...] -- writes atomically.
config_update() {
  local filter=$1 tmp
  shift
  mkdir -p -- "$CONFIG_DIR"
  tmp=$(mktemp "$CONFIG_DIR/.config.json.XXXXXX")
  if ! config_read | jq "$@" "$filter" >"$tmp"; then
    rm -f -- "$tmp"
    fail "$(tool_text 'could not update %1' "$CONFIG_FILE")"
  fi
  mv -f -- "$tmp" "$CONFIG_FILE"
}

# Run a command as root: pkexec, which shows Omarchy's password dialog. Tests
# set OMARCHY_TOOL_PRIV ("" runs it directly, "false" simulates a refusal).
privileged() {
  if [[ -n ${OMARCHY_TOOL_PRIV+x} ]]; then
    ${OMARCHY_TOOL_PRIV:+$OMARCHY_TOOL_PRIV} "$@"
  else
    pkexec "$@"
  fi
}

# --- Windows VM compose --------------------------------------------------------
#
# Several modules add to Omarchy's root-owned Windows VM compose (shared disks,
# USB devices). bin/compose-edit.sh writes all of it in one pkexec call, so
# modules never undo each other or ask for the password twice. A module offers
# <module>_compose_args (one "--share X" / "--usb Y" pair per line).
#
# $STATE_DIR/compose.applied keeps the compose mtime after our write and the
# args written, so nothing is rewritten (and no password asked) while both
# match, and a compose Omarchy regenerated (Windows reinstalled) gets ours back.

compose_record() {
  echo "$STATE_DIR/compose.applied"
}

compose_mtime() {
  stat -c %Y -- "$COMPOSE_FILE" 2>/dev/null || echo 0
}

compose_desired() {
  local name fn
  for name in $(module_names); do
    fn=$(module_fn "$name" compose_args)
    has_fn "$fn" && "$fn"
  done
  return 0
}

# Args currently in the compose, or nothing if it changed behind our back.
compose_applied() {
  local record
  record=$(compose_record)
  [[ -f $record && $(head -n1 "$record") == "$(compose_mtime)" ]] || return 0
  tail -n +2 "$record"
}

# compose_in_sync [--share|--usb]: whether that part (or all) is applied.
compose_in_sync() {
  local kind=${1:-} desired applied
  desired=$(compose_desired)
  if [[ -z $kind && -z $desired ]]; then
    [[ ! -e $(compose_record) ]]
    return
  fi
  applied=$(compose_applied)
  if [[ -n $kind ]]; then
    desired=$(grep -x -- "$kind .*" <<<"$desired" || true)
    applied=$(grep -x -- "$kind .*" <<<"$applied" || true)
  fi
  [[ $desired == "$applied" ]]
}

compose_sync() {
  local record line args=() desired
  record=$(compose_record)
  mkdir -p -- "$STATE_DIR"
  install_helper_i18n
  install -m 0644 -- "$TOOL_DIR/bin/compose-edit.sh" "$STATE_DIR/compose-edit.sh"

  # v0.0.7-v0.0.10 kept shared folders alone in windows-disks.applied.
  if [[ -f $STATE_DIR/windows-disks.applied ]]; then
    if [[ ! -e $record ]]; then
      { head -n1 "$STATE_DIR/windows-disks.applied"; tail -n +2 "$STATE_DIR/windows-disks.applied" | sed 's/^/--share /'; } >"$record"
    fi
    rm -f -- "$STATE_DIR/windows-disks.applied" "$STATE_DIR/compose-shares.sh"
  fi

  # No VM: nothing to add to, and nothing of ours can be in a compose.
  if [[ ! -f $COMPOSE_FILE ]]; then
    rm -f -- "$record"
    return 0
  fi
  compose_in_sync && return 0

  desired=$(compose_desired)
  while IFS= read -r line; do
    [[ -n $line ]] && args+=("${line%% *}" "${line#* }")
  done <<<"$desired"
  privileged /usr/bin/bash "$STATE_DIR/compose-edit.sh" "${args[@]}" || return 1

  if [[ -n $desired ]]; then
    { compose_mtime; printf '%s\n' "$desired"; } >"$record"
  else
    rm -f -- "$record"
  fi
}

# --- keyboard shortcuts --------------------------------------------------------
#
# A module offers <module>_hotkeys: Lua lines for Omarchy's Hyprland config
# (o.bind ...). They go to $HYPR_DIR/omarchy-tool.lua, which one guarded line
# in hyprland.lua loads only while it exists (the way hyprmoncfg loads its
# monitors). No shortcuts left: both the file and that line go.

HYPR_LOADER_MARK="-- Added by omarchy-tool: keyboard shortcuts of its features, loaded only while they exist."

hotkeys_sync() {
  local file="$HYPR_DIR/omarchy-tool.lua" main="$HYPR_DIR/hyprland.lua" lines='' name fn tmp before after
  for name in $(module_names); do
    fn=$(module_fn "$name" hotkeys)
    has_fn "$fn" && lines+=$("$fn")
  done

  before=$(cat -- "$file" 2>/dev/null; grep -c -- "$HYPR_LOADER_MARK" "$main" 2>/dev/null || true)
  if [[ -n $lines ]]; then
    printf '%s\n%s\n' "-- Written by omarchy-tool. Deleted when its features are switched off." "$lines" >"$file"
    if [[ -f $main ]] && ! grep -qF -- "$HYPR_LOADER_MARK" "$main"; then
      printf '\n%s\n%s\n' "$HYPR_LOADER_MARK" \
        'do local path = (os.getenv("XDG_CONFIG_HOME") or os.getenv("HOME") .. "/.config") .. "/hypr/omarchy-tool.lua"; local file = io.open(path, "r"); if file then file:close(); dofile(path) end end' >>"$main"
    fi
  else
    rm -f -- "$file"
    if [[ -f $main ]] && grep -qF -- "$HYPR_LOADER_MARK" "$main"; then
      tmp=$(mktemp "$main.XXXXXX")
      awk -v mark="$HYPR_LOADER_MARK" '
        $0 == mark { skip = 1; next }
        skip && /omarchy-tool\.lua/ { skip = 0; next }
        { skip = 0; lines[++n] = $0 }
        END {
          while (n > 0 && lines[n] == "") n--
          for (i = 1; i <= n; i++) print lines[i]
        }
      ' "$main" >"$tmp" && mv -f -- "$tmp" "$main"
    fi
  fi
  after=$(cat -- "$file" 2>/dev/null; grep -c -- "$HYPR_LOADER_MARK" "$main" 2>/dev/null || true)

  if [[ $before != "$after" && -z ${OMARCHY_TOOL_HYPR_DIR:-} ]] && command -v hyprctl >/dev/null; then
    hyprctl reload >/dev/null 2>&1 || true
  fi
}

# --- modules -----------------------------------------------------------------

module_names() {
  local file
  for file in "$TOOL_DIR"/bin/modules/*.sh; do
    [[ -e $file ]] || continue
    basename -- "$file" .sh
  done
}

for module_file in "$TOOL_DIR"/bin/modules/*.sh; do
  [[ -e $module_file ]] || continue
  # shellcheck source=/dev/null
  source "$module_file"
done

module_fn() {
  local name="${1}_${2}"
  echo "${name//-/_}"
}

has_fn() {
  declare -F -- "$1" >/dev/null
}

cmd_status() {
  local name fn json='{}' module_json
  for name in $(module_names); do
    fn=$(module_fn "$name" status)
    has_fn "$fn" || continue
    module_json=$("$fn") || module_json='{"error":"status failed"}'
    json=$(jq --arg name "$name" --argjson value "$module_json" '.[$name] = $value' <<<"$json")
  done
  jq -n --arg version "$TOOL_VERSION" --arg language "$TOOL_LANGUAGE" --argjson labels "$(tool_catalog)" \
    --arg uninstaller "$STATE_DIR/uninstall.sh" --argjson modules "$json" '
    def t($source): $labels[$source] // $source;
    def counttext($source; $n): t($source) | sub("%1"; ($n | tostring));
    {version: $version, language: $language, uninstaller: $uninstaller, modules: $modules}
    | .modules |= with_entries(
      .value.summary = (
        if (.key == "windows-disks" or .key == "usb-windows") and (.value.vmInstalled | not) then t("Windows no está instalado")
        elif (.value.enabled | not) then t("Desactivado")
        elif .key == "windows-disks" then counttext((if (.value.disks | length) == 1 then "Comparte %1 disco" else "Comparte %1 discos" end); (.value.disks | length))
        elif .key == "usb-windows" then counttext("%1 en Windows"; (.value.inWindows | length))
        elif .key == "web-devices" then counttext("%1 con acceso"; (.value.devices | length))
        elif .key == "plugins" then (.value.plugins | length | tostring) as $total
          | counttext("%1 de %2 activos"; ([.value.plugins[] | select(.enabled)] | length)) | sub("%2"; $total)
        else t(.value.summary) end))'
}

# Keep a copy of the uninstaller outside the plugin folder: once `omarchy
# plugin remove` deletes the folder, this copy is what cleans up.
install_uninstaller() {
  mkdir -p -- "$STATE_DIR"
  install -m 0755 -- "$TOOL_DIR/bin/uninstall.sh" "$STATE_DIR/uninstall.sh"
  install_helper_i18n
}

install_helper_i18n() {
  mkdir -p -- "$STATE_DIR"
  install -m 0644 -- "$TOOL_DIR/bin/i18n.sh" "$STATE_DIR/i18n.sh"
  install -m 0644 -- "$TOOL_DIR/i18n/messages.json" "$STATE_DIR/messages.json"
}

# Insert rows (one menu entry per line) before the menu file's closing brace.
# Passed through the environment: awk -v would eat the backslashes in them.
menu_insert_rows() {
  local tmp
  tmp=$(mktemp "$MENU_FILE.XXXXXX")
  MENU_ROWS=$1 awk '
    { lines[NR] = $0 }
    END {
      last = 0
      for (i = NR; i > 0; i--) if (lines[i] ~ /^}[[:space:]]*$/) { last = i; break }
      for (i = 1; i <= NR; i++) { if (i == last) print ENVIRON["MENU_ROWS"]; print lines[i] }
    }
  ' "$MENU_FILE" >"$tmp" && mv -f -- "$tmp" "$MENU_FILE"
}

# One row in the Omarchy menu that toggles the panel. Only an existing user
# menu file is touched; uninstall.sh deletes the row by the same id.
menu_entry_apply() {
  [[ -f $MENU_FILE ]] || return 0
  grep -q '^  "omarchy-tool": {' "$MENU_FILE" && return 0
  menu_insert_rows '  "omarchy-tool": {"icon":"󰦬","label":"Omarchy Tool","action":"omarchy-shell omarchy-tool toggle"},'
}

# Fast-forward the installed plugin when its git remote has new commits, via
# Omarchy's own updater. Only an install under Omarchy's plugin folder updates
# itself; a dev checkout never does. One run at a time across bar instances.
cmd_self_update() {
  local plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
  local lock="${XDG_RUNTIME_DIR:-/tmp}/omarchy-tool-update.lock" id
  id=$(jq -r '.id // empty' "$TOOL_DIR/manifest.json" 2>/dev/null)
  [[ -n $id && $TOOL_DIR == "$plugins_dir/$id" ]] || return 0
  [[ -d $TOOL_DIR/.git ]] || return 0

  exec 9>"$lock"
  flock -n 9 || return 0

  git -C "$TOOL_DIR" fetch -q origin 2>/dev/null || return 0
  local head upstream
  head=$(git -C "$TOOL_DIR" rev-parse HEAD) || return 0
  upstream=$(git -C "$TOOL_DIR" rev-parse '@{upstream}' 2>/dev/null) || return 0
  [[ $head != "$upstream" ]] || return 0
  git -C "$TOOL_DIR" merge-base --is-ancestor HEAD '@{upstream}' || return 0

  omarchy-plugin-update "$id" --yes >/dev/null 2>&1 || return 1
  local version
  version=$(jq -r '.version // ""' "$TOOL_DIR/manifest.json" 2>/dev/null)
  omarchy-notification-send -g "󰦬" "$(tool_text 'Omarchy Tool actualizado')" "$(tool_text 'Ya tienes la versión %1.' "${version:-$(tool_text nueva)}")" >/dev/null 2>&1 || true
}

cmd_apply() {
  local name fn status=0
  install_uninstaller
  menu_entry_apply
  hotkeys_sync
  for name in $(module_names); do
    fn=$(module_fn "$name" apply)
    has_fn "$fn" || continue
    "$fn" || status=1
  done
  return "$status"
}

main() {
  local command=${1:-}
  [[ $# -gt 0 ]] && shift

  # Changes run one at a time: the panel applies at shell start on every
  # monitor, and a password prompt must never show twice. Later runs then
  # find nothing left to do.
  case $command in
    status | modules | version | --version | "" | help | -h | --help | self-update | uninstall) ;;
    *)
      exec 8>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-tool.lock"
      flock 8
      ;;
  esac

  case $command in
    status) cmd_status ;;
    apply) cmd_apply ;;
    uninstall) bash "$TOOL_DIR/bin/uninstall.sh" ;;
    self-update) cmd_self_update ;;
    modules) module_names ;;
    version | --version) echo "$TOOL_VERSION" ;;
    "" | help | -h | --help)
      sed -n '3,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
      ;;
    *)
      local action=${1:-} fn
      grep -qxF -- "$command" <<<"$(module_names)" || fail "$(tool_text 'unknown command or module: %1' "$command")"
      [[ -n $action ]] || fail "$(tool_text 'missing action for module %1' "$command")"
      shift
      fn=$(module_fn "$command" "$action")
      has_fn "$fn" || fail "$(tool_text 'unknown action for %1: %2' "$command" "$action")"
      "$fn" "$@"
      ;;
  esac
}

main "$@"
